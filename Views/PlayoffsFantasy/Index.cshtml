@model PlayoffsFantasyLeaderboard

@{
    ViewData["Title"] = "BMGC";
    var rank = 1;
}

<h1>BMGC Playoffs Fantasy</h1>

@foreach (var fantasyTeam in Model.FantasyTeams.OrderByDescending(ft => ft.TotalPoints))
{
    <div class="leaderboard-team">
        <div class="leaderboard-header">
            <span>#@(rank++)</span>
            <span>@fantasyTeam.Name</span>
            <span>@fantasyTeam.TotalPoints.ToString("0.00")</span>
        </div>
        <div class="player-container">
            @foreach (var player in fantasyTeam.Players)
            {
                <div class="fantasy-player-row">
                    <span>@player.RosterPosition</span>
                    <span>@player.FirstName @player.LastName</span>
                    <span>@player.TeamShortName - @player.Postion</span>
                    <span>@player.Statlines.Sum(s => s.FantasyPoints).ToString("0.00")</span>
                    <div class="statlines-container">
                        @foreach (var week in Model.Weeks)
                        {
                            var statline = player.Statlines.FirstOrDefault(s => s.Week == week);
                            if (statline is not null)
                            {
                                <div class="player-game">
                                    <span>Week @statline.Week</span>
                                    <span>@statline.FantasyPoints.ToString("0.00")</span>
                                    <span>@statline.GameStatus</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

}

<style>
    .leaderboard-team
    {
        padding: 1rem;
        border: 1px solid grey;
        border-radius: 0.4rem;
        margin-bottom: 0.5rem;
    }

    .player-container
    {
    }

    .fantasy-player-row
    {
        padding: 0.5rem 0;
        border-top: 1px dashed grey;
    }
</style>
