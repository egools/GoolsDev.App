@model PickemData
@{
    ViewData["Title"] = "2026 Pickem";
    Layout = "_BmgcLayout";
}

@section Head {
    <style>
        body
        {
            max-width: 1000px;
            margin: 0 auto;
            padding: 10px;
        }
    </style>
}

@* NFL Pickem *@
<h2 class="pickem-header">Baldy Pickem Leaderboard</h2>
<div id="pickemLeaderboard" class="pickem-chart">
    <div class="pickem-chart-container"></div>
    <div class="bc-tip"></div>
</div>

<partial name="_GameTable" />

@* Yardage Props *@
<h2 class="pickem-header">Yardage Player Props</h2>
<div id="pickemYardage" class="pickem-chart">
    <div class="pickem-chart-container"></div>
    <div class="bc-tip"></div>
    <div>
        <ul class="bc-legend">
            @foreach (var pickerName in Model.PickerNames)
            {
                <li>
                    <button id="@pickerName" type="button" class="">
                        <i style="background: var(--@(pickerName)Color)"></i>@pickerName
                    </button>
                </li>
            }
        </ul>
        <p class="bc-note">
            dashed line marks the correct answer | outlined dot =
            closest guess | hover a name to highlight, click to pin.
        </p>
    </div>
</div>

<partial name="_ParlayTable" />

@section Scripts {

    <script src='~/js/baldy-charts.js?v=1.0'></script>
    <script>
        const PICKEM_DATA = @Html.Raw(Model.ChartDataJson);
        BaldyCharts.renderPickemLeaderboard(document.getElementById("pickemLeaderboard"), PICKEM_DATA);
        BaldyCharts.renderPickemYardage(document.getElementById("pickemYardage"), PICKEM_DATA);
    </script>
}